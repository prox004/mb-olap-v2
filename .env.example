# ==============================================================================
# MB-OLAP V2: Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# --- Warehouse Engine Selection ---
# Options: 'clickhouse' | 'duckdb' (Default: duckdb)
WAREHOUSE_BACKEND=clickhouse

# --- ClickHouse Warehouse Settings ---
# Local Docker: localhost | Remote Server: <ip-or-domain> | Cloud: <service-id>.clickhouse.cloud
CLICKHOUSE_HOST=localhost

# ClickHouse HTTP Port: 8123 for local/remote HTTP | 8443 for HTTPS (ClickHouse Cloud)
CLICKHOUSE_PORT=8123

# Database name
CLICKHOUSE_DATABASE=mb_olap_v2

# Authentication credentials
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_password_here

# --- Docker Compose Port Bindings (Optional) ---
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- DuckDB Storage Settings (Used when WAREHOUSE_BACKEND=duckdb) ---
# DUCKDB_PATH=backend/db/olap_warehouse.duckdb
# REPORTS_DB_PATH=backend/db/reports.db

# --- AI & LLM Engine Configuration ---
# Groq Cloud API Key for Conversational AI & Wren Engine (Get from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Candidate Models (Fallback chain: llama-3.3-70b-versatile -> llama-3.1-8b-instant)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# --- Agent Safety & Execution Limits ---
AGENT_MAX_ITERATIONS=5
AGENT_QUERY_TIMEOUT_SECONDS=30
AGENT_MAX_RESULT_ROWS=500

# --- Frontend Application Settings ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PORT=3000

